# ---------------------------------------------------------------------------
# AI Prepkit — environment variables
# Copy to .env and fill in what you need. Every variable below is read by the
# server package (dotenv loads ./.env from the repo root).
# ---------------------------------------------------------------------------

# ---- LLM provider -----------------------------------------------------------
# Which provider to use: "gemini" (default) | "openai" (any OpenAI-compatible
# endpoint, incl. Groq / OpenRouter / Ollama) | "mock" (deterministic, no key,
# used by tests and for offline demos).
LLM_PROVIDER=gemini

# Google AI Studio free tier (https://aistudio.google.com/app/apikey).
# Generous free tier; the pipeline adapts to 429 rate limits with backoff.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Only needed when LLM_PROVIDER=openai (e.g. Groq, OpenRouter, Ollama).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Requests per minute budget for LLM calls. Free Gemini tier allows 15; we
# default slightly under to leave headroom. The client blocks when the budget
# is exhausted and retries with jitter on 429s.
LLM_RPM=10
LLM_MAX_RETRIES=6
# Hard cap on LLM calls per kit, keeps batch runs inside the 15-minute budget.
LLM_MAX_CALLS_PER_KIT=30
LLM_TEMPERATURE=0.4

# ---- HTTP API ---------------------------------------------------------------
PORT=4000
# Comma-separated list of browser origins allowed to call the API with
# credentials (used by the Next.js dev server and the deployed frontend).
WEB_ORIGIN=http://localhost:3000
# Secret used to sign session cookies / hash session tokens at rest.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database ---------------------------------------------------------------
# MongoDB connection string (local docker or MongoDB Atlas M0 free cluster).
# Not required for `npm run evaluate` — only the web app talks to the database.
MONGODB_URI=mongodb://localhost:27017/aiprepkit

# ---- Research / crawling ----------------------------------------------------
# USER_AGENT sent with every crawl + search request.
USER_AGENT=AIPrepKitBot/1.0 (+https://github.com/yourname/aiprepkit)
# Minimum delay between requests to the same host (ms) and crawl page budget.
CRAWL_MIN_INTERVAL_MS=750
CRAWL_MAX_PAGES=14
CRAWL_MAX_DEPTH=3
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2097152
# SECURITY: in production the crawler refuses private / loopback / link-local
# addresses (SSRF protection). Local development and the batch command need
# localhost sites (the graders serve fixture sites locally), so it is allowed
# outside production. Never set NODE_ENV=production without also locking this.
ALLOW_PRIVATE_HOSTS=true

# ---- Batch evaluation -------------------------------------------------------
# Hard wall-clock budget for a single case (seconds). Protects the
# "five cases in fifteen minutes" requirement.
EVAL_CASE_TIMEOUT_SECONDS=170
